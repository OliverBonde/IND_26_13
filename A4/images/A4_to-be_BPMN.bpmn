      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="2052" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2015" y="107" width="110" height="54" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F1_di" bpmnElement="F1" bioc:stroke="#d9731a" bioc:fill="#ffe3cc"><dc:Bounds x="650" y="520" width="120" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F3_di" bpmnElement="F3" bioc:stroke="#d9731a" bioc:fill="#ffe3cc"><dc:Bounds x="1470" y="520" width="120" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F2_di" bpmnElement="F2" bioc:stroke="#d9731a" bioc:fill="#ffe3cc"><dc:Bounds x="1770" y="520" width="120" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_di" bpmnElement="SP" isExpanded="true" bioc:stroke="#a67c00" bioc:fill="#fff4b8"><dc:Bounds x="920" y="205" width="485" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2" bioc:stroke="#a67c00" bioc:fill="#fffbe3"><dc:Bounds x="945" y="245" width="120" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3" bioc:stroke="#a67c00" bioc:fill="#fffbe3"><dc:Bounds x="1095" y="245" width="120" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4" bioc:stroke="#a67c00" bioc:fill="#fffbe3"><dc:Bounds x="1245" y="245" width="120" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_ifc_di" bpmnElement="D_ifc"><dc:Bounds x="202" y="265" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="170" y="320" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_br18_di" bpmnElement="D_br18"><dc:Bounds x="1442" y="385" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1400" y="438" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_out_di" bpmnElement="D_out"><dc:Bounds x="1922" y="265" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1890" y="320" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
