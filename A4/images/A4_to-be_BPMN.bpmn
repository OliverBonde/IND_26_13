      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="795" y="290" /><di:waypoint x="630" y="290" /><di:waypoint x="630" y="130" /><bpmndi:BPMNLabel><dc:Bounds x="765" y="272" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="845" y="290" /><di:waypoint x="920" y="290" /><bpmndi:BPMNLabel><dc:Bounds x="852" y="270" width="30" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
