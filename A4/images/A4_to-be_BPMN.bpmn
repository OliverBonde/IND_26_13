<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_A4" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_A4">
    <bpmn:participant id="Pool_A4" name="A4 tool, group 13: BR18 acoustic requirement classification (to-be)" processRef="Proc_A4" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_A4" isExecutable="false">
    <bpmn:laneSet id="LaneSet_A4">
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tool" name="Tool (automatic)">
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_ifc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_br18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D_out</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ideas" name="Ideas for improvement (not implemented)">
        <bpmn:flowNodeRef>F1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Need BR18 wall requirements"><bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="U1" name="Open IFC file"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:dataInputAssociation id="da1"><bpmn:sourceRef>D_ifc</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="T1" name="Read rooms, levels, areas and room geometry"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:dataInputAssociation id="da2"><bpmn:sourceRef>D_ifc</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="U2" name="Choose building levels"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U3" name="Assign BR18 room category (IFC name is only a hint)"><bpmn:incoming>f4</bpmn:incoming><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U4" name="Start the R'w calculation"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Any rooms categorized?"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U6" name="Review pair: neighbour, door, partition, noise"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T5" name="Look up required R'w in BR18 Table 3.1"><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:dataInputAssociation id="da3"><bpmn:sourceRef>D_br18</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Status?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T6" name="Show results and colour walls on floor plan"><bpmn:incoming>f11</bpmn:incoming><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T7" name="Flag pair for manual acoustic assessment"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="U5" name="Export results CSV and floor plans PDF / SVG"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="da4"><bpmn:targetRef>D_out</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Requirement list and annotated floor plans"><bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="F1" name="IDEA: suggest room category from IFC name">
    </bpmn:task>
    <bpmn:task id="F3" name="IDEA: add impact sound and reverberation time">
    </bpmn:task>
    <bpmn:task id="F2" name="IDEA: write R'w back into the IFC model">
    </bpmn:task>
    <bpmn:subProcess id="SP" name="Identify which rooms are separated by what"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:serviceTask id="T2" name="Find neighbouring rooms (boundaries or geometry)"><bpmn:outgoing>fi1</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="T3" name="Check that a wall or slab separates them"><bpmn:incoming>fi1</bpmn:incoming><bpmn:outgoing>fi2</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="T4" name="Detect doors in the shared wall"><bpmn:incoming>fi2</bpmn:incoming></bpmn:serviceTask>
      <bpmn:sequenceFlow id="fi1" sourceRef="T2" targetRef="T3" />
      <bpmn:sequenceFlow id="fi2" sourceRef="T3" targetRef="T4" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="U1" />
    <bpmn:sequenceFlow id="f2" sourceRef="U1" targetRef="T1" />
    <bpmn:sequenceFlow id="f3" sourceRef="T1" targetRef="U2" />
    <bpmn:sequenceFlow id="f4" sourceRef="U2" targetRef="U3" />
    <bpmn:sequenceFlow id="f5" sourceRef="U3" targetRef="U4" />
    <bpmn:sequenceFlow id="f6" sourceRef="U4" targetRef="G1" />
    <bpmn:sequenceFlow id="f7" name="No" sourceRef="G1" targetRef="U3" />
    <bpmn:sequenceFlow id="f8" name="Yes" sourceRef="G1" targetRef="SP" />
    <bpmn:sequenceFlow id="f9" sourceRef="SP" targetRef="T5" />
    <bpmn:sequenceFlow id="f10" sourceRef="T5" targetRef="G2" />
    <bpmn:sequenceFlow id="f11" name="Determined" sourceRef="G2" targetRef="T6" />
    <bpmn:sequenceFlow id="f12" name="Needs input" sourceRef="G2" targetRef="U6" />
    <bpmn:sequenceFlow id="f13" name="Recalculate" sourceRef="U6" targetRef="T5" />
    <bpmn:sequenceFlow id="f14" name="Not covered" sourceRef="G2" targetRef="T7" />
    <bpmn:sequenceFlow id="f15" sourceRef="T7" targetRef="T6" />
    <bpmn:sequenceFlow id="f16" sourceRef="T6" targetRef="U5" />
    <bpmn:sequenceFlow id="f17" sourceRef="U5" targetRef="End" />
    <bpmn:dataObject id="D_ifc_obj" />
    <bpmn:dataObjectReference id="D_ifc" name="IFC model" dataObjectRef="D_ifc_obj" />
    <bpmn:dataObject id="D_br18_obj" />
    <bpmn:dataObjectReference id="D_br18" name="BR18 Table 3.1, §368–376" dataObjectRef="D_br18_obj" />
    <bpmn:dataObject id="D_out_obj" />
    <bpmn:dataObjectReference id="D_out" name="CSV, PDF and SVG files" dataObjectRef="D_out_obj" />
    <bpmn:association id="as1" associationDirection="None" sourceRef="F1" targetRef="U3" />
    <bpmn:association id="as2" associationDirection="None" sourceRef="F3" targetRef="T5" />
    <bpmn:association id="as3" associationDirection="None" sourceRef="F2" targetRef="T6" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Not covered by this tool (steps in our A2 diagram): calculating how much insulation a wall actually gives, assigning materials to walls, redesigning walls.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2"><bpmn:text>Blue = done by the user. White = done automatically by the tool. Yellow = identification of what separates which rooms (the hard part). Orange = idea, not implemented.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_A4">
    <bpmndi:BPMNPlane id="Plane_A4" bpmnElement="Collab_A4">
      <bpmndi:BPMNShape id="Pool_A4_di" bpmnElement="Pool_A4" isHorizontal="true"><dc:Bounds x="0" y="0" width="2140" height="650" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true"><dc:Bounds x="30" y="0" width="2110" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Tool_di" bpmnElement="Lane_Tool" isHorizontal="true"><dc:Bounds x="30" y="170" width="2110" height="310" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Ideas_di" bpmnElement="Lane_Ideas" isHorizontal="true"><dc:Bounds x="30" y="480" width="2110" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="82" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="55" y="107" width="90" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
